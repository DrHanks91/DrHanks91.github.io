    <category term="本科" scheme="http://drhanks91.github.io/tags/%E6%9C%AC%E7%A7%91/"/>
    <category term="毕业设计" scheme="http://drhanks91.github.io/tags/%E6%AF%95%E4%B8%9A%E8%AE%BE%E8%AE%A1/"/>
